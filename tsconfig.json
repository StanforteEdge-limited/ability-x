{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "emdash-env.d.ts", "src", "scripts", "tests", "plugins"],
  "exclude": ["node_modules", "dist"]
}
