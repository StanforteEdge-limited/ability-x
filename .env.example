# Local development. Copy to .env and fill in. Production values live in
# /etc/abilityx.env on the VPS (see deploy/abilityx.env.example).

# EmDash: encrypts plugin settings. Generate once and keep it safe.
EMDASH_ENCRYPTION_KEY=

# Local database and sessions (defaults shown)
DATABASE_PATH=./data/emdash.db
SESSION_DIR=./.astro/sessions

# Resend (forms and CMS email)
RESEND_API_KEY=

# Google Sheets (form submissions, service account)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
