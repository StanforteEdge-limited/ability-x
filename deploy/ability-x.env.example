# Runtime environment for the AbilityX service.
# Install as /etc/ability-x.env, owned by root, mode 600:
#   sudo install -o root -g root -m 600 deploy/ability-x.env.example /etc/ability-x.env
# then fill in the values with: sudo nano /etc/ability-x.env
# Check a secret is set without printing it:  sudo grep -c 'RESEND_API_KEY=.' /etc/ability-x.env

# Public origin. Baked in at build time: keep it identical in the build env
# and redeploy after any change.
EMDASH_SITE_URL=https://ability-x.org

# Database and sessions live outside the app directory.
DATABASE_PATH=/home/ability-x/data/emdash.db
SESSION_DIR=/home/ability-x/data/sessions
HOST=127.0.0.1
# Must match proxy_pass in /etc/nginx/conf.d/ability-x.conf. Check it is free first:  ss -ltnp | grep ':4321 '
PORT=4321

# Encrypts plugin settings. Generate once (npx emdash secrets generate) and keep
# a copy in the password manager: it cannot be recovered.
EMDASH_ENCRYPTION_KEY=

# Email: editor invites and sign-in links (CMS) and the website forms, all sent
# from abilityx@projectenable.africa. The key must be allowed to send from projectenable.africa.
RESEND_API_KEY=

# Website forms → Google Sheets (service account).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Purge Cloudflare's edge cache on publish. Token permission: Zone → Cache Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PURGE_ENABLED=1

# Media in R2 over the S3 API. Token permission: Object Read & Write on ability-x-media.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=ability-x-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
