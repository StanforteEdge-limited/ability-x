# Runtime environment for the AbilityX service.
# Install as /etc/abilityx.env, owned by root, mode 600:
#   sudo install -o root -g root -m 600 deploy/abilityx.env.example /etc/abilityx.env
# then fill in the values with: sudo nano /etc/abilityx.env
# Check a secret is set without printing it:  sudo grep -c 'RESEND_API_KEY=.' /etc/abilityx.env

# Public origin. Staging first; switch to https://ability-x.org at cutover
# (here AND in the build env, then redeploy).
EMDASH_SITE_URL=https://vps.ability-x.org

# Database and sessions live outside the app directory.
DATABASE_PATH=/home/abilityx/data/emdash.db
SESSION_DIR=/home/abilityx/data/sessions
HOST=127.0.0.1
# Must match proxy_pass in /etc/nginx/conf.d/abilityx.conf. Check it is free first:  ss -ltnp | grep ':4321 '
PORT=4321

# Encrypts plugin settings. Generate once (npx emdash secrets generate) and keep
# a copy in the password manager: it cannot be recovered.
EMDASH_ENCRYPTION_KEY=

# Email: editor invites and sign-in links (CMS) and the website forms.
RESEND_API_KEY=

# Website forms → Google Sheets (service account).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Purge Cloudflare's edge cache on publish. Token permission: Zone → Cache Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PURGE_ENABLED=1

# Media in R2 over the S3 API. Token permission: Object Read & Write on ability-x-media.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=ability-x-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
