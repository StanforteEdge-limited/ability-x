# Build-time configuration. These values are BAKED INTO the bundle by
# `npm run build`, so they must match /etc/abilityx.env. No secrets here.
# Install as /home/abilityx/abilityx.build.env (owned by abilityx).

EMDASH_SITE_URL=https://vps.ability-x.org
DATABASE_PATH=/home/abilityx/data/emdash.db
SESSION_DIR=/home/abilityx/data/sessions
S3_BUCKET=ability-x-media
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
# Same value as PORT in /etc/abilityx.env; the deploy script's smoke test uses it.
PORT=4321
