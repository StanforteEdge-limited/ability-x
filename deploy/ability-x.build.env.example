# Build-time configuration. These values are BAKED INTO the bundle by
# `npm run build`, so they must match /etc/ability-x.env. No secrets here.
# Install as /home/ability-x/ability-x.build.env (owned by ability-x).

EMDASH_SITE_URL=https://ability-x.org
DATABASE_PATH=/home/ability-x/data/emdash.db
SESSION_DIR=/home/ability-x/data/sessions
S3_BUCKET=ability-x-media
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
# Same value as PORT in /etc/ability-x.env; the deploy script's smoke test uses it.
PORT=4321
