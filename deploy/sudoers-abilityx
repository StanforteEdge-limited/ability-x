# The `abilityx` user may restart and inspect the site's service, and nothing else.
#
# Install (mode 440, root-owned), then check the syntax:
#   sudo install -o root -g root -m 440 deploy/sudoers-abilityx /etc/sudoers.d/abilityx
#   sudo visudo -c

abilityx ALL=(root) NOPASSWD: /usr/bin/systemctl restart abilityx.service
abilityx ALL=(root) NOPASSWD: /usr/bin/systemctl status abilityx.service
