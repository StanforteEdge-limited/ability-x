{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "AbilityX",
    "description": "AbilityX Disability Leadership Forum: speakers, schedule and blog.",
    "author": "Project Enable Africa"
  },
  "settings": {
    "title": "AbilityX",
    "tagline": "From Margins to Markets: Africa’s Blueprint for Disability-Inclusive Growth"
  },
  "collections": [
    {
      "slug": "speakers",
      "label": "Speakers",
      "labelSingular": "Speaker",
      "description": "Speakers for each AbilityX edition. 2026 speakers appear on the homepage.",
      "routable": false,
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "fields": [
        {
          "slug": "name",
          "label": "Full name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "role",
          "label": "Role / title",
          "type": "string",
          "required": true
        },
        {
          "slug": "organisation",
          "label": "Organisation",
          "type": "string"
        },
        {
          "slug": "photo",
          "label": "Photo",
          "type": "image"
        },
        {
          "slug": "session_title",
          "label": "Session title (only once confirmed)",
          "type": "string"
        },
        {
          "slug": "edition",
          "label": "Edition",
          "type": "select",
          "required": true,
          "defaultValue": "2026",
          "validation": {
            "options": [
              "2026",
              "2025"
            ]
          }
        },
        {
          "slug": "sort_order",
          "label": "Sort order (lower shows first)",
          "type": "integer",
          "defaultValue": 100
        }
      ]
    },
    {
      "slug": "programme",
      "label": "Schedule",
      "labelSingular": "Session",
      "description": "AbilityX 2026 programme sessions, shown on the Schedule page.",
      "routable": false,
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "session_type",
          "label": "Session type",
          "type": "select",
          "validation": {
            "options": [
              "Registration",
              "Opening",
              "Keynote",
              "Plenary",
              "Panel",
              "Fireside Chat",
              "Breakout",
              "Break",
              "Networking",
              "Awards",
              "Closing"
            ]
          }
        },
        {
          "slug": "start_time",
          "label": "Start time (24h, e.g. 09:00)",
          "type": "string",
          "required": true
        },
        {
          "slug": "end_time",
          "label": "End time (24h, e.g. 10:30)",
          "type": "string"
        },
        {
          "slug": "location",
          "label": "Location (e.g. Main Hall)",
          "type": "string"
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "speakers",
          "label": "Speakers",
          "type": "reference",
          "validation": {
            "targetCollection": "speakers",
            "multiple": true
          }
        }
      ]
    },
    {
      "slug": "posts",
      "label": "Blog Posts",
      "labelSingular": "Blog Post",
      "urlPattern": "/blog/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "search",
        "seo",
        "scheduling"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        },
        {
          "slug": "featured_image",
          "label": "Featured image",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "Categories",
      "labelSingular": "Category",
      "hierarchical": false,
      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "movement",
          "label": "Movement"
        }
      ]
    }
  ],
  "bylines": [
    {
      "id": "byline-abilityx-team",
      "slug": "abilityx-team",
      "displayName": "AbilityX Team"
    }
  ],
