    "posts": [
      {
        "id": "post-why-abilityx-exists",
        "slug": "why-abilityx-exists",
        "status": "published",
        "data": {
          "title": "Why AbilityX Exists",
          "excerpt": "AbilityX is building a practical platform for disability inclusion, innovation, leadership, and measurable change across Africa.",
          "content": [
            {
              "_type": "block",
              "_key": "p0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s0",
                  "text": "AbilityX exists because disability inclusion in Africa needs more than awareness. It needs infrastructure, leadership, capital, data, policy action, and platforms where persons with disabilities are positioned as builders of the future.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p1",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s1",
                  "text": "The convening brings together innovators, policymakers, startups, civil society, donors, private sector leaders, and the disability community to move from conversation to execution.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p2",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s2",
                  "text": "AbilityX 2025 proved that there is demand for a more ambitious disability inclusion ecosystem. AbilityX 2026 builds on that momentum with deeper partnerships, stronger programming, and a clearer focus on measurable outcomes.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p3",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s3",
                  "text": "This blog will share updates, ideas, stories, and practical lessons from the AbilityX community as the movement grows.",
                  "marks": []
                }
              ]
            }
          ],
          "featured_image": {
            "$media": {
              "url": "https://ability-x.org/abilityx/Extra%20Pictures/AbilityX-4.jpg",
              "alt": "Why AbilityX Exists",
              "filename": "AbilityX-4.jpg"
            }
          }
        },
        "taxonomies": {
          "category": [
            "movement"
          ]
        },
        "bylines": [
          {
            "byline": "byline-abilityx-team"
          }
        ]
      },
      {
        "id": "post-why-we-built-abilityx",
        "slug": "why-we-built-abilityx",
        "status": "published",
        "data": {
          "title": "Why We Built AbilityX: From a Forum to a Movement",
          "excerpt": "There comes a point when you realise that the conversation you started is no longer big enough for the problem you are trying to solve.",
          "content": [
            {
              "_type": "block",
              "_key": "p0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s0",
                  "text": "There comes a point when you realise that the conversation you started is no longer big enough for the problem you are trying to solve.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p1",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s1",
                  "text": "For us, that moment was the evolution from DIAL (Disability Inclusion and Leadersship) Forum to AbilityX.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p2",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s2",
                  "text": "DIAL Forum was born from an important need: to bring people together to talk about disability inclusion, share experiences, challenge assumptions and put disability on the agenda.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p3",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s3",
                  "text": "And it did exactly that.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p4",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s4",
                  "text": "But as the conversations grew, something became increasingly clear.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p5",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s5",
                  "text": "We didn't just need another forum. We needed a platform.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p6",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s6",
                  "text": "A platform where inclusion could move beyond conversation.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p7",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s7",
                  "text": "Because disability inclusion is not only a social issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p8",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s8",
                  "text": "It is an employment issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p9",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s9",
                  "text": "A business issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p10",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s10",
                  "text": "A technology issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p11",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s11",
                  "text": "An education issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p12",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s12",
                  "text": "A healthcare issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p13",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s13",
                  "text": "And increasingly, an economic issue.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p14",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s14",
                  "text": "We began asking ourselves harder questions.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p15",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s15",
                  "text": "What happens after the panel discussion?",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p16",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s16",
                  "text": "Where does a young person with a disability go to find opportunities?",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p17",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s17",
                  "text": "Where does an employer go to understand how to build a truly inclusive workplace?",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p18",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s18",
                  "text": "Where does an entrepreneur with a disability find access to markets, networks, capital and customers?",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p19",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s19",
                  "text": "Where do organisations that genuinely want to become more inclusive find the knowledge, partnerships and people to help them do it?",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p20",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s20",
                  "text": "A single event cannot answer all of those questions.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p21",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s21",
                  "text": "A platform can.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p22",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s22",
                  "text": "That thinking became the foundation for AbilityX.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p23",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s23",
                  "text": "From conversation to connection.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p24",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s24",
                  "text": "From awareness to action.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p25",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s25",
                  "text": "From visibility to opportunity.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p26",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s26",
                  "text": "AbilityX was created to bring together the different pieces of the inclusion ecosystem, persons with disabilities, businesses, employers, policymakers, development organisations, innovators, investors, media and other stakeholders, and create a space where they can do more than talk.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p27",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s27",
                  "text": "They can connect.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p28",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s28",
                  "text": "They can collaborate.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p29",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s29",
                  "text": "They can create opportunities.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p30",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s30",
                  "text": "They can build solutions.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p31",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s31",
                  "text": "And they can challenge the systems that continue to keep millions of people at the margins of economic and social participation.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p32",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s32",
                  "text": "This evolution does not mean we are leaving the DIAL (Disability Inclusion and Leadership) Forum behind.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p33",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s33",
                  "text": "Quite the opposite.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p34",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s34",
                  "text": "DIAL Forum was the beginning. AbilityX is the expansion.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p35",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s35",
                  "text": "DIAL Forum was the beginning. AbilityX is the expansion.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p36",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s36",
                  "text": "It is our response to what we have learned, what we have seen, and what we believe is possible when the right people are brought into the same room, and given the opportunity to build together.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p37",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s37",
                  "text": "And that is why AbilityX 2026 carries a theme that captures where we believe the conversation needs to go next:",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p38",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s38",
                  "text": "FROM MARGINS TO MARKETS.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p39",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s39",
                  "text": "Because inclusion should not stop at being seen.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p40",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s40",
                  "text": "It should mean being hired.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p41",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s41",
                  "text": "Being funded.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p42",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s42",
                  "text": "Being a customer.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p43",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s43",
                  "text": "Being a founder.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p44",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s44",
                  "text": "Being a decision-maker.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p45",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s45",
                  "text": "Being able to create value and access the value that already exists.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p46",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s46",
                  "text": "The journey from DIAL Forum to AbilityX is therefore more than a change of name.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p47",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s47",
                  "text": "It is a change in ambition.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p48",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s48",
                  "text": "We are building for a future where persons with disabilities are not simply included in conversations about the economy.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p49",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s49",
                  "text": "They are active participants in it.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p50",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s50",
                  "text": "And we invite organisations, leaders, innovators and changemakers who share that vision to build that future with us.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p51",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s51",
                  "text": "The next chapter is AbilityX.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "p52",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "s52",
                  "text": "And we are only getting started.",
                  "marks": []
                }
              ]
            }
          ],
          "featured_image": {
            "$media": {
              "url": "https://ability-x.org/abilityx/why%20we%20built%20ability%20x.jpeg",
              "alt": "Why We Built AbilityX: From a Forum to a Movement",
              "filename": "why we built ability x.jpeg"
            }
          }
        },
        "taxonomies": {
          "category": [
            "movement"
          ]
        },
        "bylines": [
          {
            "byline": "byline-abilityx-team"
          }
        ]
      }
    ]
  }
}
