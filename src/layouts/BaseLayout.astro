---
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "AbilityX Disability Leadership Forum." } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Nunito:wght@700;800;900&display=swap"
    />
    <EmDashHead />
  </head>
  <body class="min-h-full bg-white font-sans text-brand-black">
    <EmDashBodyStart />
    <slot />
    <EmDashBodyEnd />
  </body>
</html>
