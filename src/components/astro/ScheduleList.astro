---
import { formatTimeRange } from "@/lib/programme";
import { speakerSubtitle } from "@/lib/speakers";

export interface ScheduleSession {
  key: string;
  title: string;
  sessionType?: string | null;
  startTime: string;
  endTime?: string | null;
  location?: string | null;
  description?: string | null;
  speakers: { name: string; role?: string | null; organisation?: string | null }[];
}

interface Props {
  sessions: ScheduleSession[];
}

const { sessions } = Astro.props;
---

<ol class="divide-y divide-brand-border overflow-hidden rounded-[16px] border border-brand-border bg-white shadow-card">
  {
    sessions.map((session) => (
      <li class="grid gap-3 p-6 md:grid-cols-[200px_minmax(0,1fr)] md:gap-8 md:p-8">
        <p class="font-display text-[18px] font-black text-brand-black md:text-[20px]">
          {formatTimeRange(session.startTime, session.endTime)}
        </p>
        <div>
          {session.sessionType && (
            <p class="text-[12px] font-bold uppercase tracking-[0.12em] text-brand-red">{session.sessionType}</p>
          )}
          <h3 class="mt-1 font-display text-[22px] font-extrabold leading-tight text-brand-black">{session.title}</h3>
          {session.location && <p class="mt-1 text-sm font-semibold text-brand-muted">{session.location}</p>}
          {session.description && <p class="mt-3 text-[15px] leading-7 text-brand-muted">{session.description}</p>}
          {session.speakers.length > 0 && (
            <ul class="mt-4 space-y-1">
              {session.speakers.map((speaker) => {
                const subtitle = speakerSubtitle(speaker);
                return (
                  <li class="text-[15px] text-brand-surface">
                    <span class="font-semibold">{speaker.name}</span>
                    {subtitle && <span class="text-brand-muted">, {subtitle}</span>}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
