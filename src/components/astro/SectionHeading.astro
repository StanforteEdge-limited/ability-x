---
interface Props {
  kicker: string;
  title: string;
  body?: string;
  invert?: boolean;
  class?: string;
}

const { kicker, title, body, invert = false, class: className } = Astro.props;
---

<div class:list={["max-w-3xl", className]}>
  <p class="kicker">{kicker}</p>
  <h2
    class:list={[
      "mt-4 font-display text-3xl font-black tracking-[-0.03em] md:text-5xl",
      invert ? "text-white" : "text-brand-black",
    ]}
  >
    {title}
  </h2>
  {body && <p class:list={["mt-4 text-base leading-7 md:text-lg", invert ? "text-white/70" : "text-brand-muted"]}>{body}</p>}
</div>
