---
import { HeroSlideshow } from "@/components/react/hero-slideshow";
import Container from "@/components/astro/Container.astro";
import PillButton from "@/components/astro/PillButton.astro";
import { EVENT, REGISTER_URL } from "@/config/event";
import { heroImages } from "@/data/home";
---

<section class="relative overflow-hidden bg-brand-black pt-[96px] text-white md:pt-[112px]">
  <HeroSlideshow client:load images={heroImages} />
  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(31,31,31,0.6) 0%, rgba(13,13,13,0.85) 100%)"></div>
  <Container class="relative min-h-[760px]">
    <div class="flex min-h-[760px] items-end px-5 pb-[72px] pt-16 md:px-8 lg:px-20">
      <div class="max-w-[920px]">
        <div class="flex items-center gap-3">
          <span class="h-[2px] w-8 bg-brand-red" aria-hidden="true"></span>
          <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-brand-red">{EVENT.forumName}</p>
        </div>
        <h1 class="display-heading mt-4 text-[38px] leading-none md:text-[64px] lg:text-[80px]">
          {EVENT.themeHeadline}
        </h1>
        <p class="mt-4 max-w-[640px] font-display text-[22px] font-bold leading-snug text-white md:text-[30px]">
          {EVENT.themeSubline}
        </p>
        <div class="mt-6 space-y-1 text-base leading-7 text-white/80 md:text-[19px]">
          <p class="font-semibold text-white">{EVENT.dateLine}</p>
          <p>{EVENT.venue}</p>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <PillButton href={REGISTER_URL} class="px-6 py-3.5">Register for AbilityX 2026</PillButton>
          <PillButton href="/partner" variant="outline" class="px-6 py-3.5">Partner With Us</PillButton>
        </div>
      </div>
    </div>
  </Container>
</section>
