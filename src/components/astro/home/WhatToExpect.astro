---
import Container from "@/components/astro/Container.astro";
import SectionHeading from "@/components/astro/SectionHeading.astro";
import { CONFIRMED_PROGRAMME_FEATURES } from "@/config/event";
import { expectations, programmeFeatures } from "@/data/home";

const confirmedFeatures = programmeFeatures.filter((feature) => CONFIRMED_PROGRAMME_FEATURES.includes(feature.title));
---

<section class="section-shell bg-brand-subtle">
  <Container>
    <SectionHeading kicker="What To Expect" title="A forum built for action." />
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        expectations.map((item, index) => (
          <article class="rounded-[8px] border border-brand-border bg-white p-6 shadow-card transition-shadow duration-300 ease-in-out hover:shadow-raised">
            <p class="text-sm font-bold uppercase tracking-[0.12em] text-brand-red">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-4 font-display text-[24px] font-extrabold leading-tight text-brand-black">{item.title}</h3>
            <p class="mt-4 text-sm leading-7 text-brand-muted md:text-base">{item.description}</p>
          </article>
        ))
      }
    </div>

    {
      confirmedFeatures.length > 0 && (
        <div class="mt-12">
          <h3 class="font-display text-[22px] font-black text-brand-black md:text-[28px]">Programme features</h3>
          <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
            {confirmedFeatures.map((feature) => (
              <article class="rounded-[8px] border border-brand-border bg-white p-6 shadow-card">
                <h4 class="font-display text-[20px] font-extrabold leading-tight text-brand-black">{feature.title}</h4>
                <p class="mt-3 text-sm leading-7 text-brand-muted">{feature.description}</p>
              </article>
            ))}
          </div>
        </div>
      )
    }

    <p class="mt-10">
      <a href="/schedule" class="text-base font-semibold text-brand-red hover:text-brand-red-dark">See the schedule &rarr;</a>
    </p>
  </Container>
</section>
