---
import Container from "@/components/astro/Container.astro";
import { FOCUS_AREAS } from "@/config/event";
---

<section class="section-shell bg-brand-black text-white">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start lg:gap-16">
      <div>
        <p class="kicker">AbilityX 2026 Focus: From Margins to Markets</p>
        <h2 class="mt-4 font-display text-[32px] font-black uppercase leading-[1.05] tracking-[-0.02em] md:text-[48px]">
          Inclusion must lead to opportunity.
        </h2>
      </div>
      <div class="space-y-5 text-[17px] leading-[1.7] text-white/75 md:text-[19px]">
        <p>
          Across Africa, persons with disabilities continue to encounter barriers to employment, entrepreneurship, finance,
          technology and access to markets. AbilityX 2026 will bring the people affected by these barriers into the same
          conversation with the institutions, businesses and leaders that can help remove them.
        </p>
        <p>
          The focus this year is not only on being included, but on what inclusion makes possible: the ability to work,
          build businesses, access capital, participate in markets, innovate and create economic value.
        </p>
        <div>
          <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-white/50">Focus areas</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {FOCUS_AREAS.map((area) => <li class="rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-white">{area}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
