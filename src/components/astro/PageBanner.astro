---
import Container from "./Container.astro";

interface Props {
  imageSrc?: string;
  imageAlt: string;
  kicker: string;
  title: string;
  description: string;
}

const { imageSrc, imageAlt, kicker, title, description } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-black pt-[108px] text-white md:pt-[128px]">
  {
    imageSrc ? (
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={{ backgroundImage: `url("${encodeURI(imageSrc)}")` }}
        role="img"
        aria-label={imageAlt}
      />
    ) : (
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_75%_25%,rgba(255,255,255,0.14),transparent_28%),linear-gradient(180deg,rgba(31,31,31,0.88),rgba(13,13,13,0.92))]"
        role="img"
        aria-label={imageAlt}
      />
    )
  }

  <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(31,31,31,0.6) 0%, rgba(13,13,13,0.85) 100%)"></div>

  <Container class="relative px-5 pb-16 pt-20 md:px-8 md:pb-16 lg:px-20 lg:pb-16 lg:pt-20">
    <div class="max-w-4xl">
      <div class="flex items-center gap-3">
        <span class="h-[2px] w-8 bg-brand-red" aria-hidden="true"></span>
        <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-brand-red">{kicker}</p>
      </div>
      <h1 class="mt-4 font-display text-[34px] font-black tracking-[-0.03em] md:text-[56px]">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-white/70 md:text-xl">{description}</p>
      <slot />
    </div>
  </Container>
</section>
