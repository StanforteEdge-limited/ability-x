---
import { Image } from "emdash/ui";
import { initials } from "@/lib/speakers";

interface Props {
  name: string;
  role?: string | null;
  organisation?: string | null;
  sessionTitle?: string | null;
  photo?: { id: string; src?: string; alt?: string } | null;
}

const { name, role, organisation, sessionTitle, photo } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-[16px] border border-brand-border bg-white shadow-card">
  <div class="relative aspect-square overflow-hidden bg-brand-subtle">
    {
      photo ? (
        <Image image={photo} alt={photo.alt || `Portrait of ${name}.`} class="absolute inset-0 h-full w-full object-cover" />
      ) : (
        <span
          aria-hidden="true"
          class="absolute inset-0 flex items-center justify-center font-display text-[48px] font-black text-brand-muted-light"
        >
          {initials(name)}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-[18px] font-bold text-brand-black">{name}</h3>
    {role && <p class="mt-1 text-[14px] leading-6 text-brand-muted">{role}</p>}
    {organisation && <p class="text-[14px] font-semibold leading-6 text-brand-surface">{organisation}</p>}
    {sessionTitle && <p class="mt-3 border-t border-brand-border pt-3 text-[13px] font-semibold text-brand-red">{sessionTitle}</p>}
  </div>
</article>
