---
import { getEmDashCollection } from "emdash";
import Container from "@/components/astro/Container.astro";
import PageBanner from "@/components/astro/PageBanner.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { estimateReadTime, formatPostDate } from "@/lib/blog";

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries: posts, nextCursor } = await getEmDashCollection("posts", {
  status: "published",
  orderBy: { published_at: "desc" },
  limit: 24,
  cursor,
});
---

<BaseLayout
  title="Blog"
  active="blog"
  description="Follow the movement as we document the people, ideas, partnerships, and insights shaping disability inclusion in Africa."
>
  <PageBanner
    kicker="Blog"
    title="Ideas, Updates, and Stories from AbilityX"
    description="Follow the movement as we document the people, ideas, partnerships, and insights shaping disability inclusion in Africa."
    imageAlt="Abstract AbilityX blog banner"
  />

  <section class="section-shell bg-white">
    <Container>
      {
        posts.length === 0 ? (
          <p class="text-center text-brand-muted">No posts yet. Check back soon.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => {
              const category = post.data.terms?.category?.[0]?.label;
              const href = `/blog/${post.id}`;
              return (
                <article class="flex min-h-[300px] flex-col rounded-[16px] border border-brand-border bg-brand-subtle p-6 shadow-card transition-shadow duration-200 hover:shadow-raised">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-brand-red">
                    {category && (
                      <>
                        <span>{category}</span>
                        <span aria-hidden="true">/</span>
                      </>
                    )}
                    <span>{estimateReadTime(post.data.content)}</span>
                  </div>
                  <h2 class="mt-4 font-display text-[24px] font-black tracking-[-0.02em] text-brand-black">
                    <a href={href}>{post.data.title}</a>
                  </h2>
                  <p class="mt-3 text-sm text-brand-muted">
                    {formatPostDate(post.data.publishedAt)} by {post.data.byline?.displayName ?? "AbilityX Team"}
                  </p>
                  {post.data.excerpt && <p class="mt-4 flex-1 text-[15px] leading-7 text-brand-surface">{post.data.excerpt}</p>}
                  <a href={href} class="mt-6 inline-flex text-sm font-semibold text-brand-red">
                    Read article &rarr;
                  </a>
                </article>
              );
            })}
          </div>
        )
      }
      {
        nextCursor && (
          <div class="mt-10 text-center">
            <a href={`/blog?cursor=${encodeURIComponent(nextCursor)}`} class="text-sm font-semibold text-brand-red">
              Older posts &rarr;
            </a>
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
